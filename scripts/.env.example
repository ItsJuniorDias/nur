# OpenRouter — Flux.2 Klein 4B
# 1. Vai em https://openrouter.ai/keys
# 2. Loga (Google/GitHub) e clica "Create Key"
# 3. Confirma que tem créditos em https://openrouter.ai/credits
# 4. Cola aqui (formato começa com "sk-or-v1-..."):
OPENROUTER_API_KEY=sk-or-v1-sua-chave-aqui

# Opcionais — não precisa mexer a não ser que queira testar outro modelo
# OR_MODEL=black-forest-labs/flux.2-klein-4b       (default, ~$0.014-0.02/img)
# OR_MODEL=black-forest-labs/flux.2-flex           (melhor qualidade, ~$0.05/img)
# OR_MODEL=black-forest-labs/flux.2-pro            (topo da linha, ~$0.08/img)
# OR_MODEL=google/gemini-2.5-flash-image           (Nano Banana 1, ~$0.04/img)

# Metadados que aparecem no seu dashboard OpenRouter (opcional)
# OR_REFERRER=https://nur-atelier.com
# OR_TITLE=NUR Atelier image curation

# OR_BASE_URL=https://openrouter.ai/api/v1
# NUR_OUTPUT_DIR=../public/images
